# LLM used for parsing resumes, extracting job pages, and generating
# tailored resumes/cover letters: "anthropic" (default) or "openai"
LLM_PROVIDER=nvidia
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here
NVIDIA_API_KEY=your-nvidia-key-here

# Embeddings for job matching: "local" (default, no key needed) or "openai"
EMBEDDING_PROVIDER=local

# Adzuna API (free tier): https://developer.adzuna.com/
ADZUNA_APP_ID=Your-Adzuna-API-ID-Here
ADZUNA_APP_KEY=Your-Adzuna-API-Key-Here

# Arbeitnow requires no API key.
